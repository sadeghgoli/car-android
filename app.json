    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "نرم‌افزار ارجاع خودرو ۱۳۷ برای نمایش موقعیت خودرو و درخواست‌ها به دسترسی مکان نیاز دارد."
