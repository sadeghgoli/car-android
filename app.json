        "NSPhotoLibraryUsageDescription": "برای ثبت مستندات عملیات به گالری دسترسی لازم است.",
        "NSCameraUsageDescription": "برای ثبت عکس و فیلم عملیات به دوربین دسترسی لازم است.",
        "NSMicrophoneUsageDescription": "برای ثبت فایل صوتی عملیات به میکروفون دسترسی لازم است."
      }
    },
    "android": {
      "package": "com.sabzevar137.car",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#48DDB0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
